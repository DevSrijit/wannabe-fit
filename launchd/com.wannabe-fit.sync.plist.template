<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.wannabe-fit.sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>__UV__</string>
        <string>run</string>
        <string>--project</string>
        <string>__PROJECT__</string>
        <string>vitals</string>
        <string>sync</string>
    </array>
    <key>WorkingDirectory</key><string>__PROJECT__</string>
    <key>EnvironmentVariables</key>
    <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:__HOME__/.local/bin</string></dict>
    <key>StartInterval</key><integer>__INTERVAL__</integer>
    <key>RunAtLoad</key><true/>
    <key>StandardOutPath</key><string>__PROJECT__/data/sync.log</string>
    <key>StandardErrorPath</key><string>__PROJECT__/data/sync.log</string>
</dict>
</plist>
